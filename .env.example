# Copy to .env to change it. No passwords here: they go in secrets/.

# The host address Docker publishes the desktop on (port 3001). 127.0.0.1,
# the default, keeps it on this machine: reach it through an SSH tunnel or a
# reverse proxy on the same host. A VPN address, such as this machine's
# Tailscale IP, puts it on the VPN only.
BIND_ADDRESS=127.0.0.1

# Copy to .env to change it. No passwords here: they go in secrets/.

# The host address Docker publishes the desktops on (demo 3001, live 3101).
# 127.0.0.1, the default, keeps them on this machine: reach them through an
# SSH tunnel or a reverse proxy on the same host. A VPN address, such as this
# machine's Tailscale IP, puts them on the VPN only.
BIND_ADDRESS=127.0.0.1

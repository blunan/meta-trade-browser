# Rendered at startup by init-mt-access. Configures HTTPS desktop access and
# an internal healthcheck UNIX socket.

# Log X-Forwarded-For only when the client IP is in TRUSTED_PROXIES.
geo $mt_trusted_proxy {
  default 0;
  include /etc/nginx/mt/trusted-proxies.geo;
}
map $mt_trusted_proxy $mt_forwarded_for {
  1       $http_x_forwarded_for;
  default "-";
}

log_format mt '$remote_addr forwarded=$mt_forwarded_for user=$remote_user '
               '[$time_local] "$request" $status $body_bytes_sent "$http_user_agent"';

server {
  listen MT_LISTEN ssl;
  ssl_certificate     MT_CERT;
  ssl_certificate_key MT_KEY;

  # TRUSTED_PROXIES: when set, "allow" each entry, then "deny all".
  include /etc/nginx/mt/allow.conf;

  auth_basic           "Login";
  auth_basic_user_file /etc/nginx/.htpasswd;

  # Security headers applied to all responses.
  add_header Content-Security-Policy "frame-ancestors 'self'" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  access_log /dev/stdout mt;
  error_log  /dev/stderr error;

  # Anything outside SUBFOLDER, when SUBFOLDER isn't "/".
  include /etc/nginx/mt/outside-subfolder.conf;

  location MT_SUBFOLDER {
    alias /usr/share/selkies/web/;
    index index.html index.htm;
    try_files $uri $uri/ =404;
  }

  # Selkies streaming endpoint via UNIX socket.
  location MT_SUBFOLDERapi {
    proxy_set_header        Upgrade $http_upgrade;
    proxy_set_header        Connection "upgrade";
    proxy_set_header        Host $http_host;
    proxy_set_header        X-Real-IP $remote_addr;
    proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header        X-Forwarded-Proto $scheme;
    proxy_http_version      1.1;
    proxy_read_timeout      3600s;
    proxy_send_timeout      3600s;
    proxy_connect_timeout   3600s;
    proxy_buffering         off;
    proxy_request_buffering off;
    client_max_body_size    0;
    proxy_pass              http://unix:MT_SOCKET:;
  }
}

# Internal health check via UNIX socket. Bypasses TLS, auth, and network exposure.
server {
  listen unix:/run/mt/health.sock;
  access_log off;

  location = /healthz {
    auth_request /selkies;
    default_type text/plain;
    alias /etc/nginx/mt/healthz;
  }
  # Selkies serves its page under SUBFOLDER.
  location = /selkies {
    internal;
    proxy_pass              http://unix:MT_SOCKET:MT_SUBFOLDER;
    proxy_pass_request_body off;
    proxy_set_header        Content-Length "";
    proxy_connect_timeout   5s;
    proxy_read_timeout      5s;
  }
  location / {
    return 404;
  }
}

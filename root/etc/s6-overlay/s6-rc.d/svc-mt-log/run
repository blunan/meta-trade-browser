#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# svc-mt-log: Streams /config/log/mt/run-terminal.log to stdout (docker logs),
# rotating logs >1 MB on container startup.
set -euo pipefail

log_file=/config/log/mt/run-terminal.log
offset_file=/run/mt/log-offset

if [[ ! -f "$offset_file" ]]; then
  s6-setuidgid abc mkdir -p "${log_file%/*}"
  if [[ -f "$log_file" ]] && (( $(stat -c %s "$log_file") > 1048576 )); then
    s6-setuidgid abc mv -f "$log_file" "$log_file.1"
  fi
  s6-setuidgid abc touch "$log_file"
  # Stream only logs produced since current container start.
  stat -c %s "$log_file" > "$offset_file"
fi
exec s6-setuidgid abc tail -c "+$(($(< "$offset_file") + 1))" -F "$log_file"

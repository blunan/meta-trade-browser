#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# svc-edge-oom: when the container reaches its memory limit, the kernel stops
# the process with the highest out-of-memory score, normally the largest one:
# MetaTrader. Once a second, this gives Edge's processes (WebView2, the HTML panes)
# the highest score, so the kernel stops one of them first. That pane goes
# blank, and MetaTrader keeps running. Raising a score needs no privileges, so this
# runs as the desktop user.
set -euo pipefail

if (( EUID == 0 )); then
  exec s6-setuidgid abc "$0"
fi

events=/sys/fs/cgroup/memory.events
oom_kills() { awk '$1 == "oom_kill" { print $2 }' "$events" 2> /dev/null || echo 0; }

reported="$(oom_kills)"
while true; do
  for pid in $(pgrep -u "$EUID" -f 'msedgewebview2\.exe' || true); do
    score=
    read -r score < "/proc/$pid/oom_score_adj" 2> /dev/null || continue
    if [[ "$score" != 1000 ]]; then
      echo 1000 2> /dev/null > "/proc/$pid/oom_score_adj" || true
    fi
  done
  kills="$(oom_kills)"
  if (( ${kills:-0} > ${reported:-0} )); then
    echo "[mt-edge-oom] The container reached its memory limit (mem_limit), and the kernel stopped a process to free memory ($kills so far). An HTML pane that went blank comes back when it's closed and reopened. If this happens often, raise mem_limit."
    reported="$kills"
  fi
  sleep 1
done

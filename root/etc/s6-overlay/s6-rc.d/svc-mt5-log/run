#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# svc-mt5-log: copies MT5's log into docker logs. run-terminal.sh and the stop
# hook write it, and it stays in /config across restarts, so it also keeps
# what an earlier container wrote. Once per container start, it moves to
# run-terminal.log.1 when it's over 1 MB.
set -euo pipefail

log_file=/config/log/mt5/run-terminal.log
offset_file=/run/mt5/log-offset

if [[ ! -f "$offset_file" ]]; then
  s6-setuidgid abc mkdir -p "${log_file%/*}"
  if [[ -f "$log_file" ]] && (( $(stat -c %s "$log_file") > 1048576 )); then
    s6-setuidgid abc mv -f "$log_file" "$log_file.1"
  fi
  s6-setuidgid abc touch "$log_file"
  # docker logs gets only what this container start adds.
  stat -c %s "$log_file" > "$offset_file"
fi
exec s6-setuidgid abc tail -c "+$(($(< "$offset_file") + 1))" -F "$log_file"

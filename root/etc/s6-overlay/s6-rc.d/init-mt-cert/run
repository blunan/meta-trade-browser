#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# init-mt-cert: Generates or renews the default self-signed TLS certificate
# (/config/ssl/cert.{pem,key}) for localhost/127.0.0.1/::1 (825-day validity,
# renewed when <=30 days remain). Custom mounted certificates are preserved;
# default Linuxserver.io certificates are replaced.
set -euo pipefail

dir=/config/ssl
cert="$dir/cert.pem"
key="$dir/cert.key"
own_subject='O=metatrader-docker, CN=localhost'
# Legacy subject names from earlier project versions.
old_subjects=('O=meta-trade-browser, CN=localhost' 'O=mt-browser, CN=localhost')
base_subject='C=US, ST=CA, L=Carlsbad, O=Linuxserver.io, OU=LSIO Server, CN=*'
renew_within=$((30 * 24 * 3600))

log() { printf '[mt-cert] %s\n' "$*"; }

# Fail if mounted certificate path resolved to a directory.
for file in "$cert" "$key"; do
  if [[ -e "$file" && ! -f "$file" ]]; then
    log "ERROR: $file isn't a file. If you mount your own certificate there, check that the file the mount names exists on the server."
    exit 1
  fi
done

action=
if [[ ! -s "$cert" ]]; then
  action=made
else
  subject="$(openssl x509 -in "$cert" -noout -subject 2> /dev/null || true)"
  issuer="$(openssl x509 -in "$cert" -noout -issuer 2> /dev/null || true)"
  if [[ "$subject" == "subject=$base_subject" ]]; then
    action=replaced
  else
    for own in "$own_subject" "${old_subjects[@]}"; do
      if [[ "$subject" == "subject=$own" && "$issuer" == "issuer=$own" ]] &&
        ! openssl x509 -in "$cert" -noout -checkend "$renew_within" > /dev/null; then
        action=renewed
      fi
    done
  fi
fi
if [[ -z "$action" ]]; then
  exit 0
fi

mkdir -p "$dir"
chown abc:abc "$dir"
# Generate atomically via temporary directory.
new="$(mktemp -d "$dir/.new.XXXXXX")"
trap 'rm -rf "$new"' EXIT
if ! openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -sha256 -noenc -days 825 \
  -subj '/O=metatrader-docker/CN=localhost' \
  -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1,IP:::1' \
  -addext 'basicConstraints=critical,CA:FALSE' \
  -addext 'keyUsage=critical,digitalSignature' \
  -addext 'extendedKeyUsage=serverAuth' \
  -keyout "$new/cert.key" -out "$new/cert.pem" 2> "$new/openssl.log"; then
  log "ERROR: the desktop's certificate couldn't be made:"
  cat "$new/openssl.log"
  exit 1
fi
chown abc:abc "$new/cert.key" "$new/cert.pem"
chmod 0600 "$new/cert.key"
chmod 0644 "$new/cert.pem"
mv -f "$new/cert.key" "$key"
mv -f "$new/cert.pem" "$cert"

until="$(openssl x509 -in "$cert" -noout -enddate | cut -d= -f2)"
case "$action" in
  made) log "Made the desktop's own certificate, for localhost, 127.0.0.1 and ::1, valid until $until." ;;
  replaced) log "Replaced the base image's certificate (issued to '*' by Linuxserver.io) with the desktop's own, for localhost, 127.0.0.1 and ::1, valid until $until." ;;
  renewed) log "Renewed the desktop's own certificate, which had less than 30 days left. Valid until $until; trust it again where you trusted the old one." ;;
esac
